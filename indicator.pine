//@version=6
indicator("Simple Trend & Momentum Signals", overlay=true)

// --- Inputs ---
grpMA  = "Moving Averages"
fastLen = input.int(9, "Fast EMA Length", minval=1, group=grpMA)
slowLen = input.int(21, "Slow EMA Length", minval=1, group=grpMA)

grpRSI = "RSI Filter"
rsiLen  = input.int(14, "RSI Length", minval=1, group=grpRSI)
rsiBull = input.int(50, "Bullish RSI Threshold", minval=1, maxval=99, group=grpRSI)
rsiBear = input.int(50, "Bearish RSI Threshold", minval=1, maxval=99, group=grpRSI)

// --- Calculations ---
fastEMA = ta.ema(close, fastLen)
slowEMA = ta.ema(close, slowLen)
rsiVal  = ta.rsi(close, rsiLen)

// --- Signal Conditions ---
// BUY: Fast crosses above Slow AND RSI is above median threshold
buySignal  = ta.crossover(fastEMA, slowEMA) and rsiVal > rsiBull

// SELL: Fast crosses below Slow AND RSI is below median threshold
sellSignal = ta.crossunder(fastEMA, slowEMA) and rsiVal < rsiBear

// --- Plot Moving Averages ---
plot(fastEMA, title="Fast EMA", color=color.aqua, linewidth=2)
plot(slowEMA, title="Slow EMA", color=color.orange, linewidth=2)

// --- Plot Buy & Sell Shapes on Chart ---
plotshape(buySignal, title="Buy Signal", style=shape.labelup, location=location.belowbar,
          color=color.green, text="BUY", textcolor=color.white, size=size.small)

plotshape(sellSignal, title="Sell Signal", style=shape.labeldown, location=location.abovebar,
          color=color.red, text="SELL", textcolor=color.white, size=size.small)

// --- Alerts (Webhook / Notification Ready) ---
if buySignal and barstate.isconfirmed
    alert('{"action": "BUY", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + '}', alert.freq_once_per_bar)

if sellSignal and barstate.isconfirmed
    alert('{"action": "SELL", "ticker": "' + syminfo.ticker + '", "price": ' + str.tostring(close) + '}', alert.freq_once_per_bar)
